            "name": "Paragon Disconnect an integration",
            "description": {
              "content": "Disconnects an integration for the authenticated Connected User. When an integration is disconnected, workflows for that integration will stop running for the user and any saved User Settings will be cleared. Equivalent to the SDK function paragon.uninstallIntegration().",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":projectId",
